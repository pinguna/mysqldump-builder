<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MysqlDumpBuilder.App</RootNamespace>
    <AssemblyName>MysqlDumpBuilder</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.0</Version>
    <Product>mysqldump Command Builder</Product>
    <!-- 포터블 단일 exe 배포 (publish.cmd 참고). 압축을 켜면 크기가 절반으로 줄고 시작이 약간 느려진다. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MysqlDumpBuilder.Core\MysqlDumpBuilder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 화면 글꼴 (SIL OFL). PC 에 Noto Sans KR 이 없으면 시작할 때 임시 폴더로 풀어 프로세스 전용으로 등록한다 (AppTheme 참고). -->
    <EmbeddedResource Include="Resources\app.ico" />
    <EmbeddedResource Include="Resources\NotoSansKR.ttf" />
    <EmbeddedResource Include="Resources\NotoSansKR-OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- exe 옆에 같은 이름의 파일이 있으면 내장 스키마 대신 그 파일을 읽는다 (코드 수정 없이 옵션 편집 가능). -->
    <None Include="..\MysqlDumpBuilder.Core\Resources\options.schema.json" Link="options.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
